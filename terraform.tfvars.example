# Values for the Cypher tfvar secret (e.g. tfvars/morpheus_tf_app) used by the
# Morpheus App Blueprint, or copy to terraform.tfvars when running locally.

morpheus_url = "https://morpheus.example.com"
access_token = "00000000-0000-0000-0000-000000000000"
username     = "admin"
password     = "ChangeMe123?"
licenseKey   = "" # empty = skip activation

